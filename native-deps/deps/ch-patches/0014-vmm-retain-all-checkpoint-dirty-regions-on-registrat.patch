From beac75fe6ddf13c82b33990d4dfd99bfab86727c Mon Sep 17 00:00:00 2001
From: Chen Xiaohui <graych@gmail.com>
Date: Thu, 29 Oct 2026 00:51:29 +0800
Subject: [PATCH 14/14] vmm: retain all checkpoint dirty regions on
 registration changes

---
 vmm/src/dirty_memory.rs   | 33 +++++++++++++++++++++++++++++++++
 vmm/src/memory_manager.rs | 19 +++++++------------
 2 files changed, 40 insertions(+), 12 deletions(-)

diff --git a/vmm/src/dirty_memory.rs b/vmm/src/dirty_memory.rs
index 2a6c80d..b75cacb 100644
--- a/vmm/src/dirty_memory.rs
+++ b/vmm/src/dirty_memory.rs
@@ -63,6 +63,22 @@ impl DirtyRegion {
     }
 }
 
+// A changed registration cannot be attributed to one old slot reliably. Validate
+// the complete coordinate map before consuming any logs and retain every known
+// region conservatively before reporting an error.
+pub fn validate_regions(
+    saved: &mut [DirtyRegion],
+    mappings: impl Iterator<Item = (u32, u64, u64, u64)>,
+) -> Result<(), String> {
+    if !mappings.eq(saved.iter().map(|r| (r.slot, r.gpa, r.size, r.file_offset))) {
+        for region in saved {
+            region.all_dirty();
+        }
+        return Err("RAM registration changed".into());
+    }
+    Ok(())
+}
+
 #[derive(Serialize)]
 pub struct DirtyMemory {
     pub version: u32,
@@ -89,4 +105,21 @@ mod tests {
         assert!(a.consume(Ok(vec![0])).is_err());
         assert_eq!(a.bitmap, vec![u64::MAX, 1]);
     }
+    #[test]
+    fn changed_coordinates_or_count_preserve_all_known_regions() {
+        for mappings in [
+            vec![(2, 0, 4096, 0)],
+            vec![(2, 0, 4096, 0), (4, 1 << 32, 4096, 0)],
+        ] {
+            let mut regions = vec![
+                DirtyRegion::new(2, 0, 4096, 0).unwrap(),
+                DirtyRegion::new(4, 1 << 32, 4096, 4096).unwrap(),
+            ];
+            assert!(validate_regions(&mut regions, mappings.into_iter()).is_err());
+            assert!(regions.iter().all(|r| r.bitmap == vec![1]));
+        }
+        let mut regions = vec![DirtyRegion::new(2, 0, 4096, 0).unwrap()];
+        validate_regions(&mut regions, [(2, 0, 4096, 0)].into_iter()).unwrap();
+        assert_eq!(regions[0].bitmap, vec![0]);
+    }
 }
diff --git a/vmm/src/memory_manager.rs b/vmm/src/memory_manager.rs
index 5ff8591..e45b826 100644
--- a/vmm/src/memory_manager.rs
+++ b/vmm/src/memory_manager.rs
@@ -1131,23 +1131,18 @@ impl MemoryManager {
 
     #[allow(clippy::too_many_arguments)]
     fn collect_checkpoint_dirty(&mut self, cpu: bool) -> Result<(), Error> {
-        if self.guest_ram_mappings.len() != self.checkpoint_regions.len() {
-            for r in &mut self.checkpoint_regions {
-                r.all_dirty();
-            }
-            return Err(Error::CheckpointDirty("RAM registration changed".into()));
-        }
+        crate::dirty_memory::validate_regions(
+            &mut self.checkpoint_regions,
+            self.guest_ram_mappings
+                .iter()
+                .map(|r| (r.slot, r.gpa, r.size, r.file_offset)),
+        )
+        .map_err(Error::CheckpointDirty)?;
         for (r, saved) in self
             .guest_ram_mappings
             .iter()
             .zip(&mut self.checkpoint_regions)
         {
-            if (r.slot, r.gpa, r.size, r.file_offset)
-                != (saved.slot, saved.gpa, saved.size, saved.file_offset)
-            {
-                saved.all_dirty();
-                return Err(Error::CheckpointDirty("RAM mapping changed".into()));
-            }
             // Each consumed source is transferred before the next source or
             // slot. HTTP serialization and response delivery happen afterwards.
             let memory = self.guest_memory.memory();
