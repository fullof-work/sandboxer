 virtio-devices/src/net.rs            |  19 ++--
 virtio-devices/src/vhost_user/blk.rs |  18 ++--
 virtio-devices/src/vhost_user/fs.rs  |  18 ++--
 virtio-devices/src/vhost_user/net.rs |  24 +++--
 6 files changed, 234 insertions(+), 48 deletions(-)

