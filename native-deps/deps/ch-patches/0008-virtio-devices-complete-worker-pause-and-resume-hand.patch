-impl Pausable for VirtioCommon {
-    fn pause(&mut self) -> std::result::Result<(), MigratableError> {
+    fn unpark_threads(&self, extra_threads: &[&thread::Thread]) {
+        if let Some(epoll_threads) = &self.epoll_threads {
+            for t in epoll_threads.iter() {
+                t.thread().unpark();
+            }
+        }
+        for thread in extra_threads {
+            thread.unpark();
+        }
+    }
+
+    pub fn pause_with_threads(
+        &mut self,
+        extra_threads: &[&thread::Thread],
+    ) -> std::result::Result<(), MigratableError> {
         info!(
             "Pausing virtio-{}",
             VirtioDeviceType::from(self.device_type)
@@ -312,6 +324,12 @@ impl Pausable for VirtioCommon {
                 .write(1)
                 .map_err(|e| MigratableError::Pause(e.into()))?;
 
+            // A worker starting while paused can observe the state before the
+            // eventfd write and park after a zero-time epoll poll. Preserve an
+            // unpark token after publishing the event so that race cannot strand
+            // the worker while the control thread waits on the pause barrier.
+            self.unpark_threads(extra_threads);
+
             // Wait for all threads to acknowledge the pause before going
             // any further. This is exclusively performed when pause_evt
             // eventfd is Some(), as this means the virtio device has been
@@ -323,18 +341,116 @@ impl Pausable for VirtioCommon {
         Ok(())
     }
 
-    fn resume(&mut self) -> std::result::Result<(), MigratableError> {
+    pub fn resume_with_threads(
+        &mut self,
+        extra_threads: &[&thread::Thread],
+    ) -> std::result::Result<(), MigratableError> {
         info!(
             "Resuming virtio-{}",
             VirtioDeviceType::from(self.device_type)
         );
-        self.paused.store(false, Ordering::SeqCst);
-        if let Some(epoll_threads) = &self.epoll_threads {
-            for t in epoll_threads.iter() {
-                t.thread().unpark();
+        // A runtime pause leaves the pause event pending until resume. Drain it
+        // before waking the workers so they cannot enter the next pause while
+        // they are still completing the previous one. A restored device starts
+        // paused without a pending event and therefore needs no resume ACK.
+        let wait_for_resume_ack = if self.paused.load(Ordering::SeqCst) {
+            if let Some(pause_evt) = &self.pause_evt {
+                match pause_evt.read() {
+                    Ok(_) => true,
+                    Err(e) if e.kind() == ErrorKind::WouldBlock => false,
+                    Err(e) => return Err(MigratableError::Resume(e.into())),
+                }
+            } else {
+                false
             }
+        } else {
+            false
+        };
+
+        self.paused.store(false, Ordering::SeqCst);
+        self.unpark_threads(extra_threads);
+
+        if wait_for_resume_ack {
+            self.paused_sync.as_ref().unwrap().wait();
         }
 
         Ok(())
     }
 }
+
+impl Pausable for VirtioCommon {
+    fn pause(&mut self) -> std::result::Result<(), MigratableError> {
+        self.pause_with_threads(&[])
+    }
+
+    fn resume(&mut self) -> std::result::Result<(), MigratableError> {
+        self.resume_with_threads(&[])
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn repeated_pause_resume_waits_for_worker_ack() {
+        const ITERATIONS: usize = 100;
+
+        let paused = Arc::new(AtomicBool::new(false));
+        let paused_sync = Arc::new(Barrier::new(2));
+        let worker_paused = paused.clone();
+        let worker_sync = paused_sync.clone();
+        let worker = thread::spawn(move || {
+            for _ in 0..ITERATIONS {
+                while !worker_paused.load(Ordering::SeqCst) {
+                    thread::yield_now();
+                }
+                // Model a just-started epoll worker that observed paused before
+                // the pause event became visible, then parked after its poll.
+                // pause_with_threads() must leave an unpark token for it.
+                thread::park();
+                worker_sync.wait();
+                while worker_paused.load(Ordering::SeqCst) {
+                    thread::park();
+                }
+                worker_sync.wait();
+            }
+        });
+
+        let mut common = VirtioCommon {
+            pause_evt: Some(EventFd::new(EFD_NONBLOCK).unwrap()),
+            paused,
+            paused_sync: Some(paused_sync),
+            epoll_threads: Some(vec![worker]),
+            device_type: 1,
+            ..Default::default()
+        };
+
+        for _ in 0..ITERATIONS {
+            common.pause().unwrap();
+            common.resume().unwrap();
+        }
+
+        common
+            .epoll_threads
+            .take()
+            .unwrap()
+            .pop()
+            .unwrap()
+            .join()
+            .unwrap();
+    }
+
+    #[test]
+    fn restored_resume_does_not_wait_for_runtime_ack() {
+        let mut common = VirtioCommon {
+            pause_evt: Some(EventFd::new(EFD_NONBLOCK).unwrap()),
+            paused: Arc::new(AtomicBool::new(true)),
+            paused_sync: Some(Arc::new(Barrier::new(2))),
+            ..Default::default()
+        };
+
+        common.resume_with_threads(&[]).unwrap();
+        assert!(!common.paused.load(Ordering::SeqCst));
+    }
+}
