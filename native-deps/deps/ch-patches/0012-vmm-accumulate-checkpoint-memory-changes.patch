+#[cfg(all(test, feature = "kvm"))]
+mod checkpoint_collector_tests {
+    use super::*;
+    use vm_memory::Bytes;
+    use std::os::fd::IntoRawFd;
+
+    #[test]
+    #[ignore = "requires real /dev/kvm; run explicitly in the system Workbench"]
+    fn test_checkpoint_dirty_real_later_slot_failure_and_retry() {
+        let hypervisor = hypervisor::new().unwrap();
+        let vm = hypervisor.create_vm(Default::default()).unwrap();
+        let mut zones = Vec::new();
+        for i in 0..2 {
+            let fd = MemoryManager::memfd_create(c"checkpoint-slot", libc::MFD_CLOEXEC).unwrap();
+            // SAFETY: new uniquely owned memfd, transferred to MemoryManager.
+            let file = unsafe { File::from_raw_fd(fd) };
+            file.set_len(32 << 20).unwrap();
+            let zone: MemoryZoneConfig = serde_json::from_value(serde_json::json!({"id":format!("zone{i}"),"size":32<<20,"shared":true,"fd":file.into_raw_fd()})).unwrap();
+            zones.push(zone);
+        }
+        let config = MemoryConfig {
+            size: 0,
+            zones: Some(zones),
+            thp: false,
+            ..Default::default()
+        };
+        let manager = MemoryManager::new(
+            vm.clone(),
+            &config,
+            None,
+            40,
+            #[cfg(feature = "tdx")]
+            false,
+            None,
+            Default::default(),
+        )
+        .unwrap();
+        let mut mm = manager.lock().unwrap();
+        let seed_gpa = mm.guest_memory.memory().iter().next().unwrap().start_addr().raw_value();
+        mm.guest_memory.memory().write_obj(0x21u8, GuestAddress(seed_gpa + 12288)).unwrap();
+        mm.allocate_address_space().unwrap();
+        assert_eq!(mm.guest_ram_mappings.len(), 2);
+        assert!(
+            mm.checkpoint_dirty()
+                .unwrap()
+                .regions
+                .iter()
+                .all(|r| r.bitmap.iter().enumerate().all(|(i,w)| *w == if r.gpa == seed_gpa && i == 0 { 8 } else { 0 }))
+        );
+        let a = mm.guest_ram_mappings[0].clone();
+        let b = mm.guest_ram_mappings[1].clone();
+        let mem = mm.guest_memory.memory();
+        mem.write_obj(0x37u8, GuestAddress(a.gpa + 4096)).unwrap();
+        mem.write_obj(0x59u8, GuestAddress(b.gpa + 8192)).unwrap();
+        // Rejected migration must neither consume software writes nor disable
+        // the lifetime KVM log. Exercise all destructive owner entry points.
+        assert!(mm.ensure_migration_supported().is_err());
+        assert!(mm.start_dirty_log().is_err());
+        assert!(mm.dirty_log().is_err());
+        assert!(mm.stop_dirty_log().is_err());
+        assert!(mm.checkpoint_logging);
+        let region = mem.find_region(GuestAddress(b.gpa)).unwrap();
+        // SAFETY: the region stays mapped and alive across removal/reinstall.
+        // The missing real KVM slot causes GET_DIRTY_LOG in the production
+        // collector to fail after software logs in both slots were consumed.
+        unsafe {
+            vm.remove_user_memory_region(
+                b.slot,
+                b.gpa,
+                b.size as usize,
+                region.as_ptr(),
+                false,
+                true,
+            )
+        }
+        .unwrap();
+        assert!(mm.checkpoint_dirty().is_err());
+        assert_eq!(mm.checkpoint_regions[0].bitmap[0], 2 | if a.gpa == seed_gpa { 8 } else { 0 });
+        assert!(
+            mm.checkpoint_regions[1]
+                .bitmap
+                .iter()
+                .all(|w| *w == u64::MAX)
+        );
+        assert!(
+            mem.iter()
+                .all(|r| r.bitmap().get_and_reset().iter().all(|w| *w == 0))
+        );
+        unsafe {
+            vm.create_user_memory_region(
+                b.slot,
+                b.gpa,
+                b.size as usize,
+                region.as_ptr(),
+                false,
+                true,
+            )
+        }
+        .unwrap();
+        vm.start_dirty_log().unwrap();
+        let retry = mm.checkpoint_dirty().unwrap();
+        assert_eq!(retry.regions[0].bitmap[0], 2 | if a.gpa == seed_gpa { 8 } else { 0 });
+        assert!(retry.regions[1].bitmap.iter().all(|w| *w == u64::MAX));
+        assert_eq!(
+            mem.read_obj::<u8>(GuestAddress(a.gpa + 4096)).unwrap(),
+            0x37
+        );
+        assert_eq!(
+            mem.read_obj::<u8>(GuestAddress(b.gpa + 8192)).unwrap(),
+            0x59
+        );
+    }
