+#[cfg(test)]
+mod checkpoint_dirty_tests {
+    use super::*;
+    #[test]
+    fn test_checkpoint_dirty_net_rx_short_error_and_success() {
+        use std::os::fd::IntoRawFd;
+        use std::os::unix::net::UnixDatagram;
+        use virtio_queue::QueueT;
+        use vm_memory::bitmap::{AtomicBitmap, Bitmap};
+        use vm_memory::{Bytes, GuestAddress, GuestMemory, GuestMemoryRegion};
+        use vm_virtio::queue::testing::VirtQueue;
+        for length in [0usize, 5, 64] {
+            let mem = vm_memory::GuestMemoryMmap::<AtomicBitmap>::from_ranges(&[(
+                GuestAddress(0),
+                0x8000,
+            )])
+            .unwrap();
+            let guestq = VirtQueue::new(GuestAddress(0), &mem, 8);
+            guestq.dtable[0].set(0x4000, 8192, 2, 0);
+            guestq.avail.ring[0].set(0);
+            guestq.avail.idx.set(1);
+            let mut queue = guestq.create_queue();
+            let (input, output) = UnixDatagram::pair().unwrap();
+            input.set_nonblocking(true).unwrap();
+            let payload = vec![0x59u8; length];
+            if length != 0 {
+                output.send(&payload).unwrap();
+            }
+            // SAFETY: transfer the sole owned socket fd to the test Tap. The RX
+            // entry uses readv exactly as for a real tap; no ioctl is invoked.
+            let tap = Tap {
+                tap_file: unsafe { File::from_raw_fd(input.into_raw_fd()) },
+                if_name: vec![],
+            };
+            let bitmap = mem.find_region(GuestAddress(0)).unwrap().bitmap();
+            bitmap.get_and_reset();
+            let result = crate::queue_pair::RxVirtio::new()
+                .process_desc_chain(&mem, &tap, &mut queue, &mut None, None);
+            assert_eq!(result.is_err(), length == 5);
+            assert!(bitmap.dirty_at(0x4000) && bitmap.dirty_at(0x5000));
+            assert!(!bitmap.dirty_at(0x6000));
+            let mut bytes = vec![0; 8192];
+            mem.read_slice(&mut bytes, GuestAddress(0x4000)).unwrap();
+            let mut expected = vec![0; 8192];
+            expected[..length].copy_from_slice(&payload);
+            if length == 64 {
+                expected[10..12].copy_from_slice(&1u16.to_le_bytes());
+            }
+            assert_eq!(bytes, expected);
+            assert_eq!(guestq.used.idx.get(), if length == 64 { 1 } else { 0 });
+            if length == 64 {
+                assert!(bitmap.dirty_at(queue.used_ring() as usize));
+                assert_eq!(
+                    mem.read_obj::<u32>(vm_memory::GuestAddress(
+                        guestq.used.ring[0].location.0 + 4
+                    ))
+                    .unwrap(),
+                    64
+                );
+            }
+        }
+    }
+}
