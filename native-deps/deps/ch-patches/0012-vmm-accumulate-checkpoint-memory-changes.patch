+        assert_eq!(&data[..7], b"partial");
+        assert!(data[7..].iter().all(|b| *b == 0));
+        assert_eq!(pkt.len(), 7);
+        pkt.commit_hdr(&test_ctx.mem).unwrap();
+        assert!(bitmap.dirty_at(0x0040_0000));
+        let mut header = vec![0; VSOCK_PKT_HDR_SIZE];
+        test_ctx
+            .mem
+            .read_slice(&mut header, GuestAddress(0x0040_0000))
+            .unwrap();
+        assert_eq!(header, pkt.hdr());
+        assert!(bitmap.dirty_at(0x0040_1000));
+    }
