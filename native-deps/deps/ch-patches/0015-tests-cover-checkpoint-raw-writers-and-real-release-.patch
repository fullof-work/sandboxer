diff --git a/virtio-devices/src/vsock/packet.rs b/virtio-devices/src/vsock/packet.rs
index c073bea..22fe845 100644
--- a/virtio-devices/src/vsock/packet.rs
+++ b/virtio-devices/src/vsock/packet.rs
@@ -506,6 +506,50 @@ impl VsockPacket {
 
 #[cfg(test)]
 mod unit_tests {
+    #[test]
+    fn test_checkpoint_dirty_vsock_rx_before_partial_write() {
+        use vm_memory::bitmap::Bitmap;
+        use vm_memory::{Bytes, GuestMemory, GuestMemoryRegion};
+        let test_ctx = TestContext::new();
+        let mut ctx = test_ctx.create_epoll_handler_context();
+        let bitmap = test_ctx.mem.find_region(GuestAddress(0)).unwrap().bitmap();
+        bitmap.get_and_reset();
+        let mut pkt = VsockPacket::from_rx_virtq_head(
+            &mut ctx.handler.queues[0]
+                .iter(&test_ctx.mem)
+                .unwrap()
+                .next()
+                .unwrap(),
+            None,
+        )
+        .unwrap();
+        // The raw payload alias is dirty before a backend receives it,
+        // including a short write followed by an I/O error. The header
+        // is an owned local copy until commit_hdr writes it through Bytes.
+        assert!(!bitmap.dirty_at(0x0040_0000));
+        assert!(bitmap.dirty_at(0x0040_1000));
+        assert!(!bitmap.dirty_at(0x0040_2000));
+        pkt.buf_mut().unwrap()[..7].copy_from_slice(b"partial");
+        pkt.set_len(7);
+        let mut data = vec![0; 4096];
+        test_ctx
+            .mem
+            .read_slice(&mut data, GuestAddress(0x0040_1000))
+            .unwrap();
+        assert_eq!(&data[..7], b"partial");
+        assert!(data[7..].iter().all(|b| *b == 0));
+        assert_eq!(pkt.len(), 7);
+        pkt.commit_hdr(&test_ctx.mem).unwrap();
+        assert!(bitmap.dirty_at(0x0040_0000));
+        let mut header = vec![0; VSOCK_PKT_HDR_SIZE];
+        test_ctx
+            .mem
+            .read_slice(&mut header, GuestAddress(0x0040_0000))
+            .unwrap();
+        assert_eq!(header, pkt.hdr());
+        assert!(bitmap.dirty_at(0x0040_1000));
+    }
+
     use virtio_bindings::virtio_ring::VRING_DESC_F_WRITE;
     use virtio_queue::QueueOwnedT;
     use vm_memory::GuestAddress;
