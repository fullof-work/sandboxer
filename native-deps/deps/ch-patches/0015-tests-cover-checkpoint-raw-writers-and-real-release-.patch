+#[cfg(test)]
+mod checkpoint_release_tests {
+    use super::*;
+    use std::fs::File;
+    use std::os::fd::FromRawFd;
+    use vm_memory::FileOffset;
+
+    #[test]
+    fn test_checkpoint_dirty_release_empty_madvise_and_punch_error() {
+        // SAFETY: static NUL-terminated name, returned fd transferred once.
+        let fd =
+            unsafe { libc::memfd_create(c"checkpoint-release".as_ptr(), libc::MFD_ALLOW_SEALING) };
+        assert!(fd >= 0);
+        let file = unsafe { File::from_raw_fd(fd) };
+        file.set_len(8192).unwrap();
+        let mem = GuestMemoryMmap::from_ranges_with_files(&[(
+            GuestAddress(0),
+            8192,
+            Some(FileOffset::new(file, 0)),
+        )])
+        .unwrap();
+        // Even an all-hole range must reach MADV, so misalignment fails. The
+        // former SEEK-first early return would incorrectly accept this call.
+        assert!(matches!(
+            BalloonEpollHandler::release_memory_range(&mem, GuestAddress(1), 4096),
+            Err(Error::MadviseFail(_))
+        ));
+        BalloonEpollHandler::release_memory_range(&mem, GuestAddress(0), 4096).unwrap();
+        mem.write_obj(0x5au8, GuestAddress(4096)).unwrap();
+        // Existing mappings remain writable, but inode mutation is forbidden:
+        // a real fallocate error must retain resident contents and fail.
+        assert_eq!(
+            unsafe { libc::fcntl(fd, libc::F_ADD_SEALS, libc::F_SEAL_FUTURE_WRITE) },
+            0
+        );
+        assert!(matches!(
+            BalloonEpollHandler::release_memory_range(&mem, GuestAddress(4096), 4096),
+            Err(Error::FallocateFail(_))
+        ));
+        assert_eq!(mem.read_obj::<u8>(GuestAddress(4096)).unwrap(), 0x5a);
+    }
+}
