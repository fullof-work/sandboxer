+// Validate and mark before exposing a raw writable RX buffer, so a socket
+// partial read followed by an error cannot lose the changed guest bytes.
+fn dirty_host_address_range<M: GuestMemory + ?Sized>(
+    memory: &M,
+    addr: GuestAddress,
+    len: usize,
+) -> Option<*mut u8> {
+    let slice = memory.get_slice(addr, len).ok()?;
+    slice.bitmap().mark_dirty(0, len);
+    get_host_address_range(memory, addr, len)
