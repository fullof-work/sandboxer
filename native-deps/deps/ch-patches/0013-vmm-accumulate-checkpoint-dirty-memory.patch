--- /dev/null
+++ b/vmm/src/dirty_memory.rs
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: Apache-2.0
+// Cumulative checkpoint logs. A collection moves bits, never starts a new epoch.
+use serde::Serialize;
+
+#[derive(Clone, Serialize)]
+pub struct DirtyRegion {
+    pub slot: u32,
+    pub gpa: u64,
+    pub size: u64,
+    pub file_offset: u64,
+    pub bitmap: Vec<u64>,
+}
+
+impl DirtyRegion {
+    pub fn new(slot: u32, gpa: u64, size: u64, file_offset: u64) -> Result<Self, String> {
+        if size == 0
+            || (gpa | size | file_offset) & 4095 != 0
+            || gpa.checked_add(size).is_none()
+            || file_offset.checked_add(size).is_none()
+        {
+            return Err("unaligned or overflowing dirty region".into());
+        }
+        Ok(Self {
+            slot,
+            gpa,
+            size,
+            file_offset,
+            bitmap: vec![0; (size / 4096).div_ceil(64) as usize],
+        })
+    }
+
+    pub fn all_dirty(&mut self) {
+        self.bitmap.fill(u64::MAX);
+        let remainder = (self.size / 4096) % 64;
+        if remainder != 0 {
+            *self.bitmap.last_mut().unwrap() = (1u64 << remainder) - 1;
+        }
+    }
+
+    // A failing GET_DIRTY_LOG can already have cleared its slot before copyout
+    // fails. Preserve that slot conservatively before returning the error.
+    pub fn consume(&mut self, result: Result<Vec<u64>, String>) -> Result<(), String> {
+        let bits = match result {
+            Ok(bits) if bits.len() == self.bitmap.len() => bits,
+            Ok(_) => {
+                self.all_dirty();
+                return Err("dirty bitmap length mismatch".into());
+            }
+            Err(e) => {
+                self.all_dirty();
+                return Err(e);
+            }
+        };
+        for (saved, incoming) in self.bitmap.iter_mut().zip(bits) {
+            *saved |= incoming;
+        }
+        // Some backends pad the final word; the wire format never does.
+        let remainder = (self.size / 4096) % 64;
+        if remainder != 0 {
+            *self.bitmap.last_mut().unwrap() &= (1u64 << remainder) - 1;
+        }
+        Ok(())
+    }
+}
+
+#[derive(Serialize)]
+pub struct DirtyMemory {
+    pub version: u32,
+    pub page_shift: u32,
+    pub regions: Vec<DirtyRegion>,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn consumed_prefix_failed_slot_and_lost_response_survive_retry() {
+        let mut a = DirtyRegion::new(2, 0, 65 * 4096, 0).unwrap();
+        let mut b = DirtyRegion::new(4, 1 << 32, 4096, 65 * 4096).unwrap();
+        a.consume(Ok(vec![4, 0])).unwrap();
+        assert!(b.consume(Err("copyout EFAULT after clear".into())).is_err());
+        a.consume(Ok(vec![0, 1])).unwrap();
+        b.consume(Ok(vec![0])).unwrap();
+        let lost_response = a.clone();
+        a.consume(Ok(vec![0, 0])).unwrap();
+        assert_eq!(a.bitmap, lost_response.bitmap);
+        assert_eq!(a.bitmap, vec![4, 1]);
+        assert_eq!(b.bitmap, vec![1]);
+        assert!(a.consume(Ok(vec![0])).is_err());
+        assert_eq!(a.bitmap, vec![u64::MAX, 1]);
+    }
+}
